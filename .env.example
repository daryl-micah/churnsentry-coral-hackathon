# ─── AI Provider ──────────────────────────────────────────
# Which AI backend to use for root cause analysis.
# Options: claude | openai | copilot
# "copilot" reuses GITHUB_TOKEN — no extra key needed.
CHURNSENTRY_PROVIDER=claude

# ─── Claude (provider=claude) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (provider=openai) ─────────────────────────────
OPENAI_API_KEY=sk-...

# ─── GitHub (provider=copilot OR coral github source) ─────
# One token serves both Coral's github source AND Copilot analysis.
GITHUB_TOKEN=ghp_...

# ─── Coral source credentials ─────────────────────────────
SENTRY_ORG=your-org-slug
SENTRY_TOKEN=sntrys_...
STRIPE_API_KEY=sk_test_...
INTERCOM_ACCESS_TOKEN=...
SLACK_TOKEN=xoxb-...

# ─── Output ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GITHUB_REPO=yourorg/yourapp    # for deploy history queries

# ─── AI Provider ──────────────────────────────────────────
# Which AI backend to use for root cause analysis.
# Defaults to groq — free, fast, no payment method required.
# Options: groq | copilot | claude | openai
CHURNSENTRY_PROVIDER=groq

# ─── Groq (provider=groq) — FREE ──────────────────────────
# Get a free key at https://console.groq.com/keys (no card).
GROQ_API_KEY=gsk_...

# ─── GitHub Copilot (provider=copilot) — free if you have Copilot ─
# Reuses GITHUB_TOKEN below. No extra key.

# ─── Claude (provider=claude) — optional, paid ────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (provider=openai) — optional, paid ────────────
# OPENAI_API_KEY=sk-...

# ─── Coral source credentials ─────────────────────────────
# PostHog (custom Coral source — replaces Sentry, free tier)
POSTHOG_API_KEY=phx_...
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.posthog.com

# Plain (custom Coral source — replaces Intercom, free tier)
PLAIN_API_KEY=plain_api_key_...

# Stripe (bundled Coral source — read-only; restricted key recommended)
STRIPE_API_KEY=sk_test_...

# GitHub (bundled Coral source; also reused by provider=copilot)
GITHUB_TOKEN=ghp_...

# Slack (bundled Coral source)
SLACK_TOKEN=xoxb-...

# ─── Output ───────────────────────────────────────────────
# Optional: post the report to Slack via incoming webhook.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GITHUB_REPO=yourorg/yourapp    # for deploy history queries
